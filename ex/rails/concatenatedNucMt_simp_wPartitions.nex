	lset applyto=(4) nst=2 rates=gamma;
	lset applyto=(5) nst=2 rates=gamma;
	lset applyto=(6) nst=6 rates=gamma;
	lset applyto=(7) nst=2 rates=gamma;
	lset applyto=(8) nst=2 rates=gamma;
	lset applyto=(9) nst=2 rates=gamma;
	lset applyto=(10) nst=2 rates=gamma;
	lset applyto=(11) nst=6 rates=gamma;
	lset applyto=(12) nst=2 rates=gamma;
	lset applyto=(13) nst=6 rates=gamma;
	lset applyto=(14) nst=6 rates=gamma;

	prset applyto=(all) ratepr=variable;
	unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all) tratio=(all);

end;

END;


